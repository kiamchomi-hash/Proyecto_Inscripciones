{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "paths": {
      "next/link": ["./cloudflare/src/entrega/next-link.tsx"],
      "next/image": ["./cloudflare/src/entrega/next-image.tsx"],
      "next/navigation": ["./cloudflare/src/entrega/next-navigation.ts"],
      "next/dynamic": ["./cloudflare/src/entrega/next-dynamic.tsx"],
      "next/font/google": ["./cloudflare/src/entrega/next-font.ts"],
      "@next/third-parties/google": ["./cloudflare/src/entrega/next-third-parties.ts"],
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    ".claude",
    "cloudflare",
    "contenidos",
    ".next/dev"
  ]
}
