NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VENTAS_STORAGE_BUCKET=ventas-privadas
# Lo valida PUT /api/admin/buscador. Deja que el actualizador de precios,
# que corre local y no tiene sesion, publique el buscador sin la service role.
BUSCADOR_SECRET=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=www.siglo21sur.com
NEXT_PUBLIC_GA_ID=G-4QJGQV3N1R
# Lo valida /api/revalidar: el mismo valor va en el trigger notify_revalidar()
# de la base, que es el unico que llama a ese endpoint.
REVALIDATE_SECRET=
# Las tres son de las Edge Functions, no de Next: Telegram es el unico canal de
# avisos y WEBHOOK_SECRET valida que el pedido venga del trigger de la base.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_SECRET=

# Rol acotado de Postgres para editar contenido desde local (sql/2026-08-28_rol_editor_contenido.sql)
EDITOR_DATABASE_URL=


# Publicacion de los informes a un repo privado, para leerlos desde el celular.
# Las sesiones de Claude en la nube no llegan a googleapis.com, asi que el
# informe SEO se genera solo en esta maquina; esto lo deja donde el celular si
# puede leerlo. Sin estas dos variables el informe igual se guarda local.
# El repo tiene que ser privado: el informe lleva consultas y rendimiento.
# INFORMES_REPO=kiamchomi-hash/informes-cau
# INFORMES_TOKEN=
