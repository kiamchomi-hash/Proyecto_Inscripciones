NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_EXPECTED_HOSTNAME=www.siglo21sur.com
# Sólo desarrollo: sin claves Turnstile, habilita el token de prueba local.
# No saltea el rate limit ni habilita escrituras.
NEXT_PUBLIC_FORMULARIOS_PRUEBA_LOCAL=0
NEXT_PUBLIC_GA_ID=G-4QJGQV3N1R
# Lo valida /api/revalidar del Worker.
REVALIDATE_SECRET=
# Telegram es el unico canal de avisos: lo usan el Worker y la vigilancia local.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Publicacion de los informes a un repo privado, para leerlos desde el celular.
# Las sesiones de Claude en la nube no llegan a googleapis.com, asi que el
# informe SEO se genera solo en esta maquina; esto lo deja donde el celular si
# puede leerlo. Sin estas dos variables el informe igual se guarda local.
# El repo tiene que ser privado: el informe lleva consultas y rendimiento.
# INFORMES_REPO=kiamchomi-hash/informes-cau
# INFORMES_TOKEN=   

# Mail de «Ver precio» y newsletter de Teclab (SMTP2GO). Sensitive en Cloudflare.
SMTP2GO_API_KEY=

# Autentica los crons del Worker: /api/vigilancia, /api/newsletter y
# /api/recordatorio-teclab.
CRON_SECRET=
# Modo demo de formularios: sólo en desarrollo, sin captcha y sin escribir nada.
NEXT_PUBLIC_FORMULARIOS_DEMO=0
