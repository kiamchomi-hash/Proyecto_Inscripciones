{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cau-cloudflare-local",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "APP_STAGE": "local" },
  "d1_databases": [{
    "binding": "DB", "database_name": "cau-d1-local",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "migrations", "remote": false
  }],
  "queues": {
    "producers": [{ "binding": "EFECTOS", "queue": "cau-efectos-local" }],
    "consumers": [{
      "queue": "cau-efectos-local", "max_batch_size": 10,
      "max_batch_timeout": 1, "max_retries": 3,
      "retry_delay": 10, "dead_letter_queue": "cau-efectos-dlq-local"
    }]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "dev": { "ip": "127.0.0.1", "port": 4329 }
}
