---
import { env } from 'cloudflare:workers';
import Sitio from '../layouts/Sitio.astro';
import PaginaHome from '../entrega/PaginaHome';
import PaginaIdentidad from '../entrega/PaginaIdentidad';
import SiteFooter from '@/components/footer';
import { carrerasDeHome, carrerasDeIdentidad } from '../datos/home.ts';
import { configTurnstile } from '../entrega/entorno-publico.ts';
import { baseDeSitio, sitioDe } from '../entrega/sitios.ts';
import '@/estilos/index.css';
import '@/components/index/modales.css';
import '@/components/formularios/formulario-lead.css';
import { PAGINAS } from '@/lib/paginas';

// Home paritaria con `app/page.tsx`: mismo título absoluto, misma descripción,
// mismos componentes y mismo orden. El catálogo se lee de D1 con la taxonomía
// compartida; el texto largo de las fichas no viaja en el HTML, igual que hoy.
// La oferta ya está orientada al ciclo académico 2027, aunque el año civil aún sea 2026.
//
// topykly.com sirve la portada de la Academia Identidad Argentina: el mismo
// catálogo, acotado a sus diplomaturas y cursos.
const anio = 2027;
const sitio = sitioDe(Astro.url.hostname, (env as unknown as { APP_SITIO?: string }).APP_SITIO);
const identidad = sitio === 'identidad';
const base = baseDeSitio(sitio);
const carreras = identidad ? await carrerasDeIdentidad(env.DB) : await carrerasDeHome(env.DB);
// La configuración del captcha se resuelve una vez en el servidor: la usan el
// `<meta>` del layout y el contexto de la isla, para que el HTML renderizado
// no dependa de leer el documento en el navegador.
const turnstile = configTurnstile(env as unknown as Record<string, unknown>);
---

{identidad ? (
  <Sitio
    base={base}
    marca="identidad"
    titulo="Academia Identidad Argentina | Diplomaturas y cursos"
    descripcion="Diplomaturas y cursos de la Academia Identidad Argentina."
    canonical={`${base}/`}
    ruta="/"
  >
    <PaginaIdentidad carreras={carreras} turnstile={turnstile} client:idle />
    <SiteFooter baseHref="https://www.siglo21sur.com" />
  </Sitio>
) : (
  <Sitio
    titulo={`Universidad Siglo 21 | CAU Online | Oferta académica ${anio}`}
    descripcion={PAGINAS.home.descripcion}
    canonical={base}
    ruta="/"
  >
    {/* `client:idle` y no `client:load`: el catálogo ya viene renderizado del
        servidor y los 45 módulos del bundle competían con el primer pintado por
        ancho de banda y CPU (LCP 3,2 s en móvil, 1/11/2026). La isla hidrata en
        la primera ventana de ocio, después del `load`. */}
    <PaginaHome carreras={carreras} turnstile={turnstile} client:idle />
    <SiteFooter />
  </Sitio>
)}
