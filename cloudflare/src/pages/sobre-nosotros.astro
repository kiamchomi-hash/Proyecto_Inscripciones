---
import Sitio from '../layouts/Sitio.astro';
import Pagina, { metadata, PREGUNTAS_SEDE } from '@/paginas/sobre-nosotros';
import { jsonLdScript } from '@/lib/json-ld';

// Las mismas preguntas que se ven en la página. Google pide que el `FAQPage`
// coincida con el contenido visible; declararlo desde la misma lista evita que
// se despeguen.
const faq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: PREGUNTAS_SEDE.map(q => ({
    '@type': 'Question',
    name: q.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: q.respuesta },
  })),
};
---
<Sitio titulo="CAU Siglo 21 en CABA | Villa Lugano, Guaminí 4876"
  descripcion={metadata.description as string} palabrasClave={metadata.keywords as string[]}
  canonical="https://www.siglo21sur.com/sobre-nosotros" ruta="/sobre-nosotros">
  <Pagina client:load />
  <script type="application/ld+json" set:html={jsonLdScript(faq)} />
</Sitio>
