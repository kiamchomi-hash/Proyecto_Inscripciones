---
import { env } from 'cloudflare:workers';
import Sitio from '../../layouts/Sitio.astro';
import PaginaMateria from '../../entrega/PaginaMateria';
import SiteFooter from '@/components/footer';
import { leerMateriaPublica, listarNavegacionMaterias } from '../../datos/materias';
import { configTurnstile } from '../../entrega/entorno-publico';
import { jsonLdScript } from '@/lib/json-ld';
import '@/estilos/clases-apoyo/clases-apoyo.css';
import '@/estilos/clases-apoyo/reserva-clase.css';
import '@/estilos/clases-apoyo/computacion.css';
const [ficha, otras] = await Promise.all([leerMateriaPublica(env.DB, Astro.params.materia!), listarNavegacionMaterias(env.DB)]);
if (!ficha) return new Response(null, { status: 404 });
const BASE_URL = 'https://www.siglo21sur.com';
const url = `${BASE_URL}/clases-apoyo/${ficha.slug}`;
const turnstile = configTurnstile(env as unknown as Record<string, unknown>);
const serviceSchema = {
  '@context': 'https://schema.org', '@type': 'Service', name: `Clases particulares de ${ficha.label}`,
  serviceType: 'Clases de apoyo escolar', description: `Clases particulares de ${ficha.label} en Villa Lugano, presenciales.`, url,
  areaServed: { '@type': 'Place', name: 'Villa Lugano, Ciudad Autónoma de Buenos Aires' },
  provider: { '@type': 'EducationalOrganization', name: 'CAU Villa Lugano — Universidad Siglo 21', url: BASE_URL,
    address: { '@type': 'PostalAddress', streetAddress: 'Guaminí 4876', addressLocality: 'Villa Lugano', addressRegion: 'Ciudad Autónoma de Buenos Aires', addressCountry: 'AR' } },
};
const breadcrumbSchema = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: BASE_URL },
  { '@type': 'ListItem', position: 2, name: 'Clases de apoyo', item: `${BASE_URL}/clases-apoyo` },
  { '@type': 'ListItem', position: 3, name: ficha.label, item: url },
] };
---
<Sitio titulo={`Clases particulares de ${ficha.label} en Villa Lugano | CAU Siglo 21`}
  descripcion={`Clases particulares y apoyo escolar de ${ficha.label} en Villa Lugano: presenciales, individuales o en grupo reducido, con horario a convenir. Guaminí 4876.`}
  canonical={url} ruta={`/clases-apoyo/${ficha.slug}`} robots={ficha.en_construccion ? 'noindex, follow' : undefined}>
  <PaginaMateria ficha={ficha} otras={otras} turnstile={turnstile} client:load />
  <SiteFooter />
  {!ficha.en_construccion && <script type="application/ld+json" set:html={jsonLdScript(serviceSchema)} />}
  <script type="application/ld+json" set:html={jsonLdScript(breadcrumbSchema)} />
</Sitio>
