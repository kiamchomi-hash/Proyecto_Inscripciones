---
import { env } from 'cloudflare:workers';
import Sitio from '../layouts/Sitio.astro';
import Test from '@/components/test-vocacional/test-vocacional';
import { opcionesVocacional } from '../datos/vocacional';
import '@/estilos/test-vocacional/test-vocacional.css';
import { PAGINAS } from '@/lib/paginas';
const carreras = await opcionesVocacional(env.DB);
---
<Sitio titulo="Test vocacional: descubrí qué carrera va con vos | Siglo 21"
  descripcion={PAGINAS.vocacional.descripcion}
  canonical="https://www.siglo21sur.com/test-vocacional" ruta="/test-vocacional">
  <main class="vocacional-page"><div class="vocacional-shell"><Test carreras={carreras} client:load /></div></main>
</Sitio>
