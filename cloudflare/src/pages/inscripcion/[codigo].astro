---
import { env } from 'cloudflare:workers';
import Sitio from '../../layouts/Sitio.astro';
import PaginaInscripcionEnlace from '../../entrega/PaginaInscripcionEnlace';
import { cargarInscripcionEnlace } from '../../datos/inscripcion-enlace';
import { configTurnstile } from '../../entrega/entorno-publico';
import '../../estilos/poppins.css';
import '@/components/formularios/formulario-lead.css';
import '@/app/inscripcion/[codigo]/inscripcion-enlace.css';

// La capacidad del código sólo viaja en esta respuesta dinámica no-store. Nunca
// se introduce en canonical, metas sociales, logs ni artefactos de compilación.
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
const demo = env.APP_STAGE === 'local' && Astro.params.codigo === 'demo';
// Mismo demo explícito de desarrollo que Next: no consulta D1 ni envía un POST.
const demostracion = {
  estado: 'valido' as const,
  props: {
    codigo: 'demo',
    carrera: { nombre: 'Tecnicatura Superior en Programación', url: '/carreras/tecnicatura-superior-en-programacion', duracion: '2 años' },
    precio: { estado: 'vigente' as const, precio: {
      conceptos: [{ concepto: 'Matrícula', monto: '$ 64.228', descuento: 75 }, { concepto: 'Bimestre 2B', monto: '$ 488.131', descuento: 24 }],
      total: '$ 552.359', nota: null, vigenteHasta: '2026-10-31',
    } },
    datos: { nombre: 'Prueba Demo', dni: '99000099', email: 'prueba@example.test', carrera: 'Tecnicatura Superior en Programación' },
    completo: true,
  },
};
let carga;
try {
  carga = demo ? demostracion : await cargarInscripcionEnlace(env.DB, Astro.params.codigo!);
} catch {
  // Nada del error del driver (SQL, legajo o código) se registra.
  return new Response(null, { status: 503, headers: { 'Cache-Control': 'no-store' } });
}
const titulo = 'Tu inscripción en Teclab';
const descripcion = 'Revisá tus datos y el precio de tu carrera, y confirmá tu inscripción. Al inscribirte todavía no pagás nada.';
const imagen = '/imagenes/og/default-teclab-inscripcion.jpg';
---
<Sitio titulo={titulo} descripcion={descripcion} ruta={Astro.url.pathname} robots="noindex, nofollow"
  og={{ tipo: 'website', locale: 'es_AR', sitio: 'CAU Online', titulo, descripcion,
    imagen: { url: imagen, ancho: 1200, alto: 630, alt: 'Tu inscripción en Teclab' } }}
  twitter={{ tarjeta: 'summary_large_image', titulo, descripcion, imagen }}>
  <PaginaInscripcionEnlace carga={carga} demo={demo} turnstile={configTurnstile(env as unknown as Record<string, unknown>)} client:load />
</Sitio>
