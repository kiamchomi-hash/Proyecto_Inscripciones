  descripcion={metadata.description as string} palabrasClave={metadata.keywords as string[]}
  canonical="https://www.siglo21sur.com/calendario-academico" ruta="/calendario-academico"
  og={{tipo: 'article', titulo: 'Calendario Académico 2026 e Inscripción 2027 — Universidad Siglo 21 a Distancia',
    descripcion: 'Inicio de cursada, cierre de inscripción a materias, integradores y feriados del ciclo 2026, con la inscripción 2027 abierta.',
    url: '/calendario-academico', imagen: {url: '/imagenes/og/default.jpg', ancho: 1200, alto: 630, alt: 'Universidad Siglo 21 — CAU Online'}}}>
